# demo (par défaut) / live (données venant des API). Ne jamais mettre de secrets VITE_ ici.
VITE_DATA_MODE=demo
# Base URL de ton API Gateway : /api utilise le proxy Vite en développement.
VITE_API_BASE_URL=/api
# Optionnel : pour contacter chaque API sur son propre port SANS gateway.
# Si vide, utilise VITE_API_BASE_URL pour ce service.
VITE_SENSORS_API_URL=
VITE_ALERTS_API_URL=
VITE_REPORTS_API_URL=
VITE_AUTH_API_URL=
VITE_ORDERS_API_URL=
VITE_USERS_API_URL=
VITE_MONITORING_API_URL=
# Vide = même origine via proxy /socket.io ; sinon URL du realtime-service.
VITE_SOCKET_URL=
# Evénement Socket.IO émis par realtime-service. Exemple : measurement, sensor:reading.
VITE_SOCKET_EVENT=measurement
# Intervalle de rafraîchissement des API REST en millisecondes.
VITE_POLL_MS=10000
